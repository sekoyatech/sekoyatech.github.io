---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieConsent from '../components/ui/CookieConsent.astro';
import { SITE, PLAUSIBLE_DOMAIN } from '../lib/constants';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo';
import { getOgImageUrl } from '../lib/utils';
import { useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  canonicalURL = Astro.url.href,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const t = useTranslations();
const fullTitle = `${title} | ${SITE.name}`;
const ogImage = getOgImageUrl(image, SITE.url);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Theme script - must be before body to prevent FOUC -->
    <script is:inline>
      (function() {
        function applyTheme(doc) {
          var theme = localStorage.getItem('theme');
          if (theme === 'light') {
            doc.documentElement.classList.remove('dark');
            doc.documentElement.classList.add('light');
          } else {
            doc.documentElement.classList.remove('light');
            doc.documentElement.classList.add('dark');
          }
        }

        applyTheme(document);

        document.addEventListener('astro:before-swap', function(e) {
          applyTheme(e.newDocument);
        });
      })();
    </script>

    <!--
      Entrance animations hide their targets with opacity: 0, but that must only
      happen when the script that reveals them is actually going to run. This
      class is what scopes the hiding in global.css: without it every
      [data-reveal] section and the hero render plainly, so no-JS visitors and
      the window before the module executes both see content rather than a blank
      page. Set here, synchronously in <head>, so there is no flash of visible
      content before the animation starts.

      The hero entrance is pure CSS and needs nothing further. The scroll reveal
      does depend on a script to add .revealed, so it gets a safety net: if that
      script never runs, dropping .js-anim makes the sections visible instead of
      leaving them hidden forever. scroll-reveal sets data-anim-ready to cancel it.
    -->
    <script is:inline>
      (function() {
        function armAnimations(doc) {
          var root = doc.documentElement;
          delete root.dataset.animReady;
          root.classList.add('js-anim');

          setTimeout(function() {
            if (root.dataset.animReady !== '1') root.classList.remove('js-anim');
          }, 3000);
        }

        armAnimations(document);
        document.addEventListener('astro:before-swap', function(e) {
          armAnimations(e.newDocument);
        });
      })();
    </script>

    <ClientRouter />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Webmaster Verification — replace TODO values with actual codes -->
    <!-- <meta name="google-site-verification" content="TODO_GOOGLE_CODE" /> -->
    <!-- <meta name="msvalidate.01" content="TODO_BING_CODE" /> -->
    <!-- <meta name="yandex-verification" content="TODO_YANDEX_CODE" /> -->

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={organizationJsonLd()} />
    <script type="application/ld+json" set:html={websiteJsonLd()} />

    <!-- Analytics -->
    <script defer data-domain={PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.js"></script>

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href="/rss.xml" />

    <slot name="head" />

    <script>
      import '../scripts/scroll-reveal';
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text font-sans antialiased">
    <a href="#main" class="skip-nav">{t('common.skip_nav')}</a>
    <Header />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
