---
import BlogCard from './BlogCard.astro';
import { calculateReadingTime } from '../../lib/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  posts: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags?: string[];
      heroImage?: string;
      heroImageAlt?: string;
      featured?: boolean;
      draft?: boolean;
    };
  }[];
  featuredPost?: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags?: string[];
      heroImage?: string;
      heroImageAlt?: string;
      featured?: boolean;
    };
  };
}

const { posts, featuredPost } = Astro.props;
const t = useTranslations();
---

<!--
  Two columns, not three. The featured card spans the full width and splits its
  media and text 50/50, and in a two-column grid that split falls exactly on the
  gutter between the columns below it — in a three-column grid it landed
  mid-column, so the card read as misaligned with everything under it. Two
  columns also leaves no empty cell for the common case of one featured post plus
  an even number of others, and gives every card a wider image.
-->
{posts.length === 0 && !featuredPost ? (
  <p class="text-center text-text-muted py-12">{t('blog.no_posts')}</p>
) : (
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {featuredPost && (
      <BlogCard
        title={featuredPost.data.title}
        description={featuredPost.data.description}
        pubDate={featuredPost.data.pubDate}
        tags={featuredPost.data.tags}
        href={`/blog/${featuredPost.id}/`}
        readingTime={calculateReadingTime(featuredPost.body ?? '')}
        slug={featuredPost.id}
        heroImage={featuredPost.data.heroImage}
        heroImageAlt={featuredPost.data.heroImageAlt}
        featured={true}
      />
    )}
    {posts.map((post) => (
      <BlogCard
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        href={`/blog/${post.id}/`}
        readingTime={calculateReadingTime(post.body ?? '')}
        slug={post.id}
        heroImage={post.data.heroImage}
        heroImageAlt={post.data.heroImageAlt}
      />
    ))}
  </div>
)}
