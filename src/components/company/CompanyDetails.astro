---
/**
 * Public legal identity of the operating entity: registered name, office
 * address and statutory registration numbers.
 *
 * This block exists so that partners, vendors and certification programmes can
 * verify the business directly from the website. Keep the values in sync with
 * ADDRESS / COMPANY in src/lib/constants.ts — do not hardcode them here.
 */
import { SITE, ADDRESS, ADDRESS_MAPS_URL, ADDRESS_LOCALITY, COMPANY } from '../../lib/constants';
import { useTranslations } from '../../i18n/utils';

interface Props {
  /** Render the heading and intro paragraph. Off when the host page has its own. */
  showHeading?: boolean;
  class?: string;
}

const { showHeading = true, class: className = '' } = Astro.props;

const t = useTranslations();

const rows = [
  { label: t('company.legal_name'), value: COMPANY.legalName },
  { label: t('company.trade_name'), value: COMPANY.tradeName },
  { label: t('company.legal_form'), value: COMPANY.legalForm },
  { label: t('company.tax_office'), value: COMPANY.taxOffice },
  { label: t('company.tax_id'), value: COMPANY.taxId },
  { label: t('company.mersis'), value: COMPANY.mersisNo },
  { label: t('company.trade_registry'), value: COMPANY.tradeRegistryNo },
  { label: t('company.founded'), value: String(SITE.foundedYear) },
];
---

<section class:list={['bg-surface border border-border rounded-xl p-6 md:p-8', className]} id="company-information">
  {showHeading && (
    <>
      <h2 class="text-xl md:text-2xl font-bold text-text mb-3">{t('company.title')}</h2>
      <p class="text-sm text-text-muted leading-relaxed mb-8 max-w-2xl">{t('company.subtitle')}</p>
    </>
  )}

  <!-- Registered office -->
  <div class="mb-8">
    <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-3">
      {t('company.registered_office')}
    </h3>
    <address class="not-italic text-text-muted text-sm leading-relaxed">
      <span class="block font-medium text-text">{COMPANY.legalName}</span>
      <span class="block">{ADDRESS.street}</span>
      <span class="block">{ADDRESS_LOCALITY} / {ADDRESS.city}</span>
      <span class="block">{ADDRESS.country}</span>
    </address>
    <a
      href={ADDRESS_MAPS_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 mt-3 text-sm text-primary hover:underline"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
      </svg>
      {t('contact.info.directions')}
    </a>
  </div>

  <!-- Registration details -->
  <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-4 text-sm">
    {rows.map((row) => (
      <div class="flex flex-col gap-0.5 min-w-0">
        <dt class="text-text-muted">{row.label}</dt>
        <dd class="text-text font-medium break-words">{row.value}</dd>
      </div>
    ))}
  </dl>

  <!-- Commercial support statement -->
  <div class="mt-8 pt-6 border-t border-border">
    <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-2">
      {t('company.support.title')}
    </h3>
    <p class="text-sm text-text-muted leading-relaxed">
      {t('company.support.text')}{' '}
      <a href={`mailto:${SITE.email}`} class="text-primary hover:underline">{SITE.email}</a>.
    </p>
  </div>
</section>
